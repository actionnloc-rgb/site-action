rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validLead() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'nome',
          'telefone',
          'telefoneE164',
          'periodo',
          'projeto',
          'equipamentos',
          'status',
          'origem',
          'createdAt'
        ])
        && d.keys().hasAll([
          'nome',
          'telefone',
          'telefoneE164',
          'periodo',
          'projeto',
          'equipamentos',
          'status',
          'origem',
          'createdAt'
        ])
        && d.nome is string
        && d.nome.size() >= 1
        && d.nome.size() <= 120
        && d.telefone is string
        && d.telefone.size() >= 1
        && d.telefone.size() <= 30
        && d.telefoneE164 is string
        && d.telefoneE164.matches('^55[0-9]{10,11}$')
        && d.periodo is string
        && d.periodo.size() <= 120
        && d.projeto is string
        && d.projeto.size() >= 1
        && d.projeto.size() <= 2000
        && d.equipamentos is list
        && d.equipamentos.size() <= 30
        && d.status == 'novo'
        && d.origem == 'site'
        && d.createdAt == request.time;
    }

    match /admins/{uid} {
      // Criado apenas pelo Firebase Console. Permite que o usuário autenticado
      // verifique apenas o próprio documento para confirmar acesso ao painel.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /meta/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /equipment/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    match /services/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    match /projects/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    match /leads/{id} {
      allow create: if validLead();
      allow read, update, delete: if isAdmin();
    }
  }
}
